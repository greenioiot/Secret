# Start Secrets at boot. Install (once):
#   sudo cp /mnt/project2/Secret/tools/secrets.service /etc/systemd/system/ && sudo systemctl daemon-reload && sudo systemctl enable secrets
# Stop any copy started by hand first (pkill -f run.sh from another shell), then: sudo systemctl start secrets
[Unit]
Description=Secrets meeting recorder (web app + worker, port 8444)
After=network-online.target cdsprpcd.service genie-edge.service
Wants=network-online.target
RequiresMountsFor=/mnt/project2

[Service]
User=dev
Group=dev
SupplementaryGroups=render video audio dmaheap
WorkingDirectory=/mnt/project2/Secret
ExecStart=/mnt/project2/Secret/run.sh
# run.sh already restarts the server after its own watchdog exit (75); systemd covers crashes and kills
Restart=on-failure
RestartSec=5
# give the server time to close an open recording cleanly
TimeoutStopSec=30
KillSignal=SIGINT

[Install]
WantedBy=multi-user.target
